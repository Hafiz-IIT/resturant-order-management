MONGO_URI=mongodb://127.0.0.1:27017/restaurant_order_management
# Generate a unique random secret with at least 32 bytes of entropy.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_bytes_long
# Set once for first-admin creation, then remove from the runtime environment.
ADMIN_BOOTSTRAP_SECRET=replace_with_a_separate_random_secret_at_least_32_bytes_long
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
PORT=5000
